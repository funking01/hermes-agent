load("//anybuild/tools:python.bzl", "python_build", "python_config", "python_serve")

config = python_config(
    schema = 1,
    python_version = "3.13",
    uv_version = "0.8.15",
)

build = python_build(config)

python_serve(
    config,
    build,
    name = "hermes-agent",
    build_pre = [
        env(UV_INDEX_STRATEGY = "unsafe-best-match"),
    ],
)
